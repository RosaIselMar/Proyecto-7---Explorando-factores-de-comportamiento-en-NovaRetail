   "source": [
    "### V de Cramér"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "PQ86ahU8g14j",
   "metadata": {
    "id": "PQ86ahU8g14j"
   },
   "outputs": [],
   "source": [
    "# Función para calcular V de Cramér\n",
    "from scipy.stats import chi2_contingency\n",
    "\n",
    "def cramer_v(df, col1, col2):\n",
    "    # tabla de contingencia\n",
    "    tabla = pd.crosstab(df[col1], df[col2])\n",
    "    \n",
    "    # calcular chi-cuadrado\n",
    "    chi2, p_value, dof, expected = chi2_contingency(tabla)\n",
    "    \n",
    "    # calcular coeficiente V de Cramér\n",
    "    n = tabla.values.sum()\n",
    "    v = np.sqrt(chi2 / (n * (min(tabla.shape) -1)))\n",
    "    \n",
    "    return v\n"
   ]
  },
